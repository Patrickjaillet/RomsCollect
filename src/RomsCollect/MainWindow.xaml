<ui:FluentWindow x:Class="RomsCollect.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RomsCollect"
        xmlns:vm="clr-namespace:RomsCollect.ViewModels"
        xmlns:controls="clr-namespace:RomsCollect.Views.Controls"
        xmlns:loc="clr-namespace:RomsCollect.Helpers"
        xmlns:conv="clr-namespace:RomsCollect.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        PreviewKeyDown="OnPreviewKeyDown">
    <ui:FluentWindow.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <conv:EnumNotEqualToVisibilityConverter x:Key="EnumNotEqualToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding ToggleGridWheelLayoutCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:LocalizedString App.Title}"
                     VerticalAlignment="Top" />

        <!-- Top menu bar: text-only dropdown menus, no ribbon -->
        <Menu Grid.Row="1" Background="Transparent" Padding="8,4">
            <MenuItem Header="{loc:LocalizedString Menu.Menu}">
                <MenuItem Header="{loc:LocalizedString Menu.Menu.Import}" />
                <MenuItem Header="{loc:LocalizedString Menu.Menu.Scan}" InputGestureText="Ctrl+R" Click="OnScanMenuItemClick" />
                <Separator />
                <MenuItem Header="{loc:LocalizedString Menu.Menu.Settings}" Click="OnSettingsMenuItemClick" />
                <MenuItem Header="{loc:LocalizedString Menu.Menu.KeyboardShortcuts}" Click="OnKeyboardShortcutsMenuItemClick" />
                <MenuItem Header="{loc:LocalizedString Menu.Menu.About}" Click="OnAboutMenuItemClick" />
                <Separator />
                <MenuItem Header="{loc:LocalizedString Menu.Menu.Exit}" Click="OnExitMenuItemClick" />
            </MenuItem>
            <MenuItem Header="{loc:LocalizedString Menu.Tools}" />
            <MenuItem Header="{loc:LocalizedString Menu.Skin}" />
            <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy}">
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.GridView}"
                          Command="{Binding SetLayoutModeCommand}" CommandParameter="{x:Static vm:GameLayoutMode.Grid}" />
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.WheelView}"
                          Command="{Binding SetLayoutModeCommand}" CommandParameter="{x:Static vm:GameLayoutMode.Wheel}" />
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.ListView}"
                          Command="{Binding SetLayoutModeCommand}" CommandParameter="{x:Static vm:GameLayoutMode.List}" />
                <Separator />
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.SortTitle}"
                          Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:GameSortMode.Title}" />
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.SortYear}"
                          Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:GameSortMode.ReleaseDate}" />
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.SortRating}"
                          Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:GameSortMode.Rating}" />
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.SortLastPlayed}"
                          Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:GameSortMode.LastPlayed}" />
                <MenuItem Header="{loc:LocalizedString Menu.ArrangeBy.SortPlayCount}"
                          Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:GameSortMode.PlayCount}" />
            </MenuItem>
            <MenuItem Header="{loc:LocalizedString Menu.ImageGroup}" />
            <MenuItem Header="{loc:LocalizedString Menu.Badges}" />
        </Menu>

        <!-- Search field + status bar -->
        <Grid Grid.Row="1" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="SearchBox"
                        Grid.Column="0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{loc:LocalizedString Search.Placeholder}"
                        Icon="{ui:SymbolIcon Search24}" />

            <ui:Button Grid.Column="1"
                       Icon="{ui:SymbolIcon Filter24}"
                       Command="{Binding Filters.ToggleOpenCommand}"
                       ToolTip="{loc:LocalizedString Search.AdvancedFilters}"
                       Margin="4,0,0,0" Padding="6" />

            <ui:Button Grid.Column="2"
                       Icon="{ui:SymbolIcon Alert24}"
                       Click="OnLastScanNotificationClick"
                       ToolTip="{Binding LastScanSummaryText}"
                       Visibility="{Binding LastScanSummaryText, Converter={StaticResource NullToVisibilityConverter}}"
                       Margin="4,0,0,0" Padding="6" />

            <ui:Button Grid.Column="3"
                       Icon="{ui:SymbolIcon FullScreenMaximize24}"
                       Click="OnToggleFullScreenClick"
                       ToolTip="{loc:LocalizedString Search.FullScreen}"
                       Margin="4,0,0,0" Padding="6" />

            <TextBlock Grid.Column="4"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Opacity="0.75" />
        </Grid>

        <!-- Advanced search filter panel, toggled by the filter icon above. -->
        <Border Grid.Row="1" Grid.RowSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,40,16,0" Padding="16"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Width="260" Panel.ZIndex="10"
                Visibility="{Binding Filters.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{loc:LocalizedString Search.AdvancedFilters}" FontWeight="SemiBold" Margin="0,0,0,8" />

                <TextBlock Text="{loc:LocalizedString Search.Filter.Genre}" Opacity="0.7" Margin="0,4,0,2" />
                <ComboBox ItemsSource="{Binding Filters.AvailableGenres}" SelectedItem="{Binding Filters.SelectedGenre}" />

                <TextBlock Text="{loc:LocalizedString Search.Filter.Year}" Opacity="0.7" Margin="0,8,0,2" />
                <ComboBox ItemsSource="{Binding Filters.AvailableYears}" SelectedItem="{Binding Filters.SelectedYear}" />

                <TextBlock Text="{loc:LocalizedString Search.Filter.MinimumRating}" Opacity="0.7" Margin="0,8,0,2" />
                <Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Filters.MinimumRating}" />

                <TextBlock Text="{loc:LocalizedString Search.Filter.Completeness}" Opacity="0.7" Margin="0,8,0,2" />
                <ComboBox ItemsSource="{Binding Filters.AvailableCompletenessValues}" SelectedItem="{Binding Filters.SelectedCompleteness}" />

                <CheckBox Content="{loc:LocalizedString Search.Filter.FavoritesOnly}" IsChecked="{Binding Filters.FavoritesOnly}" Margin="0,12,0,0" />
                <CheckBox Content="{loc:LocalizedString Search.Filter.CompletedOnly}" IsChecked="{Binding Filters.CompletedOnly}" Margin="0,4,0,0" />

                <ui:Button Content="{loc:LocalizedString Search.Filter.Reset}" Command="{Binding Filters.ResetCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="12,4" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Left sidebar: systems/platforms, plus user-defined collections -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Systems}"
                         SelectedItem="{Binding SelectedSystem}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SystemListItemViewModel}">
                            <controls:SystemListItemControl />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="4,0,0,0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- New collection form -->
                <Grid Grid.Row="1" Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{loc:LocalizedString Sidebar.NewCollectionPlaceholder}"
                                Margin="0,0,4,0" />
                    <ui:Button Grid.Column="1" Content="+" Command="{Binding AddCollectionCommand}" Padding="12,2" />
                </Grid>
            </Grid>

            <!-- Center: game grid. A ListBox (rather than a plain ItemsControl) is
                 used so arrow-key navigation, Home/End and PageUp/PageDown work
                 out of the box, keeping keyboard and mouse navigation in sync
                 through the same SelectedItem binding. -->
            <ListBox Grid.Column="1"
                     ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding LayoutMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:GameLayoutMode.Grid}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                        <controls:GameCardControl IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="ContextMenuOpening" Handler="OnGameCardContextMenuOpening" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu x:Name="GameCardContextMenu" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Center: game wheel/carousel -->
            <controls:GameWheelControl Grid.Column="1"
                                        Visibility="{Binding LayoutMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:GameLayoutMode.Wheel}}"
                                        PlayRequested="OnGamePlayRequested" />

            <!-- Right: quick detail panel of the selected game -->
            <controls:GameDetailPanelControl Grid.Column="2"
                                              DataContext="{Binding SelectedGame}"
                                              EditRequested="OnGameEditRequested"
                                              MoreDetailsRequested="OnGameMoreDetailsRequested"
                                              ToggleFavoriteRequested="OnGameToggleFavoriteRequested"
                                              ToggleCompletedRequested="OnGameToggleCompletedRequested"
                                              DeleteRequested="OnGameDeleteRequested"
                                              OpenRomFolderRequested="OnGameOpenRomFolderRequested"
                                              PlayRequested="OnGamePlayRequested"
                                              Visibility="{Binding DataContext.LayoutMode, ElementName=RootWindow, Converter={StaticResource EnumNotEqualToVisibilityConverter}, ConverterParameter={x:Static vm:GameLayoutMode.List}}" />

            <!-- Tabular catalog view, spans the center + detail panel
                 columns when active -->
            <controls:CatalogListControl Grid.Column="1" Grid.ColumnSpan="2"
                                          DataContext="{Binding Catalog}"
                                          Visibility="{Binding DataContext.LayoutMode, ElementName=RootWindow, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:GameLayoutMode.List}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
