<ui:FluentWindow x:Class="RomsCollect.Views.Windows.BulkAddTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:RomsCollect.Helpers"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{loc:LocalizedString Catalog.BulkAddTag.Title}"
        Height="200" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:LocalizedString Catalog.BulkAddTag.Title}" />

        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="24,12,24,8" TextWrapping="Wrap" />

        <ui:TextBox x:Name="TagTextBox" Grid.Row="2" Margin="24,0,24,0" VerticalAlignment="Top"
                    PlaceholderText="{loc:LocalizedString Catalog.BulkAddTag.Placeholder}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
            <ui:Button Content="{loc:LocalizedString Catalog.BulkAddTag.Cancel}" Click="OnCancelClick" Padding="20,8" Margin="0,0,8,0" />
            <ui:Button Content="{loc:LocalizedString Catalog.BulkAddTag.Confirm}" Appearance="Primary" Click="OnConfirmClick" Padding="20,8" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
