<ui:FluentWindow x:Class="RomsCollect.Views.Windows.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:RomsCollect.ViewModels"
        xmlns:loc="clr-namespace:RomsCollect.Helpers"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{loc:LocalizedString AddGame.Title}"
        Height="280" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        d:DataContext="{d:DesignInstance Type=vm:AddGameViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:LocalizedString AddGame.Title}" />

        <StackPanel Grid.Row="1" Margin="24,8">
            <TextBlock Text="{loc:LocalizedString AddGame.GameTitle}" Margin="0,8,0,4" />
            <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{loc:LocalizedString AddGame.Platform}" Margin="0,16,0,4" />
            <ComboBox ItemsSource="{Binding AvailableSystems}" SelectedItem="{Binding SelectedSystem}" DisplayMemberPath="Name" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
            <ui:Button Content="{loc:LocalizedString AddGame.Cancel}" Click="OnCancelClick" Margin="0,0,8,0" Padding="20,8" />
            <ui:Button Content="{loc:LocalizedString AddGame.Save}" Appearance="Primary" Command="{Binding SaveCommand}" Padding="20,8" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
