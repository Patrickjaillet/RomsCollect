<UserControl x:Class="RomsCollect.Views.Controls.CatalogListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RomsCollect.ViewModels"
             xmlns:loc="clr-namespace:RomsCollect.Helpers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: Add Games, Select Columns, Group By -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8">
            <ui:Button Content="{loc:LocalizedString Catalog.AddGames}" Icon="{ui:SymbolIcon Add24}" Click="OnAddGamesClick" Padding="14,6" Margin="0,0,8,0" />
            <ui:Button Content="{loc:LocalizedString Catalog.SelectColumns}" Icon="{ui:SymbolIcon ColumnEdit24}" Click="OnSelectColumnsClick" Padding="14,6" Margin="0,0,8,0" />

            <TextBlock Text="{loc:LocalizedString Catalog.GroupBy}" VerticalAlignment="Center" Margin="16,0,8,0" Opacity="0.7" />
            <ComboBox SelectedValue="{Binding GroupingMode}" Width="200" VerticalAlignment="Center">
                <ComboBoxItem Content="{loc:LocalizedString Catalog.GroupBy.NoFolders}" Tag="{x:Static vm:CatalogGroupingMode.NoFolders}" />
                <ComboBoxItem Content="{loc:LocalizedString Catalog.GroupBy.Platform}" Tag="{x:Static vm:CatalogGroupingMode.Platform}" />
                <ComboBoxItem Content="{loc:LocalizedString Catalog.GroupBy.Completeness}" Tag="{x:Static vm:CatalogGroupingMode.Completeness}" />
                <ComboBoxItem Content="{loc:LocalizedString Catalog.GroupBy.PlatformAndCompleteness}" Tag="{x:Static vm:CatalogGroupingMode.PlatformAndCompleteness}" />
                <ComboBoxItem Content="{loc:LocalizedString Catalog.GroupBy.Genre}" Tag="{x:Static vm:CatalogGroupingMode.Genre}" />
                <ComboBoxItem Content="{loc:LocalizedString Catalog.GroupBy.Developer}" Tag="{x:Static vm:CatalogGroupingMode.Developer}" />
                <ComboBoxItem Content="{loc:LocalizedString Catalog.GroupBy.Publisher}" Tag="{x:Static vm:CatalogGroupingMode.Publisher}" />
            </ComboBox>
        </StackPanel>

        <!-- Bulk actions bar, visible only while at least one row is checked -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8" VerticalAlignment="Top">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CheckedRowCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding CheckedRowCount, StringFormat={}{0} selected}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />
            <ui:Button Content="{loc:LocalizedString Catalog.Bulk.Delete}" Icon="{ui:SymbolIcon Delete24}" Click="OnBulkDeleteClick" Appearance="Danger" Padding="12,6" Margin="0,0,8,0" />
            <ui:Button Content="{loc:LocalizedString Catalog.Bulk.AddTag}" Click="OnBulkAddTagClick" Padding="12,6" Margin="0,0,8,0" />
            <ui:Button Content="{loc:LocalizedString Catalog.Bulk.SetStatus}" Click="OnBulkSetStatusClick" Padding="12,6" Margin="0,0,8,0" />
            <ui:Button Content="{loc:LocalizedString Catalog.Bulk.ExportCsv}" Click="OnBulkExportCsvClick" Padding="12,6" />
        </StackPanel>

        <!-- Grouped, sortable data grid; columns are generated in code-behind
             from CatalogViewModel.VisibleColumns so "Select Columns" is
             reflected without hand-listing every possible column here. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupsItemsControl" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CatalogGroupViewModel}">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding GroupName}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="12,12,12,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GroupName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding Rows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserSortColumns="False"
                                      CanUserReorderColumns="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="Transparent"
                                      RowHeight="32"
                                      Loaded="OnRowsDataGridLoaded"
                                      Sorting="OnDataGridSorting"
                                      ColumnReordered="OnColumnReordered" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
