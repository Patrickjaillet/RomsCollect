<UserControl x:Class="RomsCollect.Views.Controls.GameDetailPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RomsCollect.ViewModels"
             xmlns:conv="clr-namespace:RomsCollect.Converters"
             xmlns:loc="clr-namespace:RomsCollect.Helpers"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameCardViewModel}">
    <UserControl.Resources>
        <conv:RatingToStarsConverter x:Key="RatingToStarsConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <TextBlock Text="{loc:LocalizedString Detail.NoGameSelected}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="24">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="180" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Fanart banner with the game's Clear Logo overlaid -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Image Source="{Binding FanartBackgroundImagePath}"
                       Stretch="UniformToFill"
                       Visibility="{Binding FanartBackgroundImagePath, Converter={StaticResource NullToVisibilityConverter}}" />
                <Rectangle Fill="#66000000" />
                <Image Source="{Binding ClearLogoImagePath}"
                       Stretch="Uniform"
                       MaxHeight="110"
                       Margin="24"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Visibility="{Binding ClearLogoImagePath, Converter={StaticResource NullToVisibilityConverter}}" />
            </Grid>

            <!-- Everything below the fanart banner scrolls, so the quick
                 actions row is always reachable even on a short window. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Rating / system / title header, with the Play button -->
            <Grid Grid.Row="0" Margin="24,16,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}"
                               Foreground="#FFD700"
                               FontSize="16" />
                    <TextBlock Text="{Binding SystemName}"
                               FontSize="12"
                               Opacity="0.7"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="26"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}"
                               Click="OnMoreDetailsClick"
                               ToolTip="{loc:LocalizedString GameDetails.Title}"
                               FontSize="16"
                               Padding="10"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{loc:LocalizedString GameActions.Edit}"
                               Icon="{ui:SymbolIcon Edit24}"
                               Click="OnEditClick"
                               FontSize="16"
                               Padding="16,10"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{loc:LocalizedString Detail.Play}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}"
                               Click="OnPlayClick"
                               ToolTip="F5"
                               FontSize="16"
                               Padding="24,10" />
                </StackPanel>
            </Grid>

            <!-- Central media preview: a gameplay video when one is set for
                 this game, falling back to the static image preview
                 (Box - Front by default, or a clicked filmstrip thumbnail)
                 otherwise. -->
            <Border Grid.Row="1" Margin="24,8" CornerRadius="6" ClipToBounds="True"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Image Source="{Binding SelectedPreviewImagePath}"
                           Stretch="Uniform"
                           Visibility="{Binding VideoPath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

                    <Grid Visibility="{Binding VideoPath, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <MediaElement x:Name="VideoPlayer"
                                      Grid.Row="0"
                                      Source="{Binding VideoPath}"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      MediaOpened="OnVideoMediaOpened"
                                      MediaEnded="OnVideoMediaEnded" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#AA000000" Margin="0,0,0,0">
                            <ui:Button x:Name="VideoPlayPauseButton"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Click="OnVideoPlayPauseClick"
                                       Padding="8" Margin="4" />
                            <Slider x:Name="VideoScrubber"
                                    Width="200"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    PreviewMouseDown="OnVideoScrubberPreviewMouseDown"
                                    PreviewMouseUp="OnVideoScrubberPreviewMouseUp" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Filmstrip of available media thumbnails; click one to show it in the central preview above. -->
            <ScrollViewer Grid.Row="2" Margin="24,0,24,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding MediaThumbnails}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="120" Height="70" Margin="0,0,8,0" CornerRadius="4" ClipToBounds="True"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnFilmstripThumbnailClick">
                                <Image Source="{Binding}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Information grid -->
            <Grid Grid.Row="3" Margin="24,8,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:LocalizedString Detail.ReleaseDate}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding Game.ReleaseDate}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:LocalizedString Detail.Developer}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding PrimaryDeveloperName}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:LocalizedString Detail.Publisher}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding PrimaryPublisherName}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="{loc:LocalizedString Detail.PlayTime}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding TotalPlayTimeDisplay}" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Second, more detailed Information block -->
            <Grid Grid.Row="4" Margin="24,0,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{loc:LocalizedString Detail.Information}" FontWeight="SemiBold" Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                    <TextBlock Text="{loc:LocalizedString Detail.Info.Rating}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding Rating}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <TextBlock Text="{loc:LocalizedString Detail.Info.Genre}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding PrimaryGenreName}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="{loc:LocalizedString Detail.Info.PlayMode}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding Game.PlayMode}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                    <TextBlock Text="{loc:LocalizedString Detail.Info.Region}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding Game.Region}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="{loc:LocalizedString Detail.Info.Status}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding StatusText}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="{loc:LocalizedString Detail.Info.ImportedRom}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding ImportedRomText}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="{loc:LocalizedString Detail.Info.Portable}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding PortableText}" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Quick actions -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="24,0,24,16">
                <ToggleButton IsChecked="{Binding IsFavorite, Mode=OneWay}"
                              Click="OnToggleFavoriteClick"
                              Content="{loc:LocalizedString GameActions.ToggleFavorite}"
                              ToolTip="Ctrl+D"
                              Padding="12,6"
                              Margin="0,0,8,0" />
                <ToggleButton IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              Click="OnToggleCompletedClick"
                              Content="{loc:LocalizedString GameActions.ToggleCompleted}"
                              ToolTip="Ctrl+T"
                              Padding="12,6"
                              Margin="0,0,8,0" />
                <ui:Button Content="{loc:LocalizedString GameActions.OpenRomFolder}"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OnOpenRomFolderClick"
                           Padding="12,6"
                           Margin="0,0,8,0" />
                <ui:Button Content="{loc:LocalizedString GameActions.Delete}"
                           Icon="{ui:SymbolIcon Delete24}"
                           Click="OnDeleteClick"
                           Appearance="Danger"
                           Padding="12,6" />
            </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
